# Runs examples/agent_session.jsonl through m6510tool serve; every reply line must start with {"ok":true.
execute_process(COMMAND ${TOOL} serve INPUT_FILE ${SESSION} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "serve failed (${rc}): ${err}")
endif()
file(STRINGS ${SESSION} requests)
string(REPLACE "\n" ";" replies "${out}")
list(FILTER replies EXCLUDE REGEX "^$")
list(LENGTH requests nreq)
list(LENGTH replies nrep)
if(NOT nreq EQUAL nrep)
  message(FATAL_ERROR "${nreq} requests but ${nrep} replies:\n${out}")
endif()
foreach(r IN LISTS replies)
  if(NOT r MATCHES "^\\{\"ok\":true")
    message(FATAL_ERROR "a request failed: ${r}")
  endif()
endforeach()
string(FIND "${out}" "HELLO FROM THE 6510" pos)
if(pos EQUAL -1)
  message(FATAL_ERROR "the program's output is missing:\n${out}")
endif()
