# build output
/build*/
/out/
/cmake-build-*/
CMakeUserPresets.json

# IDE / editor
.vs/
.vscode/
.idea/
.cache/
*.swp
*~
.DS_Store

# generated by the tools
*.o
*.obj
*.a
*.lib
*.exe

# local ROM images are never committed (copyright): BASIC, KERNAL, character ROM, 1541 DOS
/roms/
*.rom
basic*.bin
kernal*.bin
chargen*.bin
characters*.bin

__pycache__/
*.pyc

# files the tests write into the working directory (they delete them again; an aborted run can leave them behind)
m6510_*.tmp
m6510_*.prg
m6510_*.bin
m6510_*.snap
m6510_*.d64
m6510_*_failure.asm
m6510_mon_*.asm

# local reverse-engineering material (disk/tape/cartridge images, memory dumps, listings of other people's programs) must never be committed
*.d64
*.d71
*.d81
*.g64
*.t64
*.tap
*.crt
*.vsf
/local/
